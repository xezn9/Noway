<?xml version="1.0" encoding="utf-8"?>
<!-- Every text follows the layout direction (right in RTL) no matter if it is English or Arabic,
     otherwise a row mixes left-aligned English titles with right-aligned Arabic values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:textAlignment="viewStart"
    android:textDirection="locale">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="120dp">

        <TextView
            style="@style/SettingsSection"
            android:text="Appearance" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="Theme" />

                    <TextView
                        android:id="@+id/text_current_theme"
                        style="@style/SettingsRowSubtitle"
                        android:layout_marginTop="2dp"
                        android:text="System Default" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.6"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/settings_app_color" />

                    <TextView
                        android:id="@+id/text_current_color"
                        style="@style/SettingsRowSubtitle"
                        android:layout_marginTop="2dp"
                        android:text="Blue" />

                    <!-- filled in code: one round swatch per colour of AccentPalette -->
                    <GridLayout
                        android:id="@+id/grid_colors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:columnCount="5"
                        android:layoutDirection="locale" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsSection"
            android:text="@string/settings_liquid_glass" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <!-- live preview: a colourful scene with a real glass card on top -->
                <com.mfp.filemanager.ui.views.GlassPreviewView
                    android:id="@+id/glass_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Blur -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_glass_blur" />

                    <TextView
                        android:id="@+id/text_blur_value"
                        style="@style/SettingsRowSubtitle"
                        android:layout_width="wrap_content"
                        android:text="50%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_blur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_glass_blur"
                    android:stepSize="1"
                    android:value="50"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <!-- Transparency -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_glass_transparency" />

                    <TextView
                        android:id="@+id/text_transparency_value"
                        style="@style/SettingsRowSubtitle"
                        android:layout_width="wrap_content"
                        android:text="50%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_transparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_glass_transparency"
                    android:stepSize="1"
                    android:value="50"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <!-- Refraction -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_glass_refraction" />

                    <TextView
                        android:id="@+id/text_refraction_value"
                        style="@style/SettingsRowSubtitle"
                        android:layout_width="wrap_content"
                        android:text="50%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_refraction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings_glass_refraction"
                    android:stepSize="1"
                    android:value="50"
                    android:valueFrom="0"
                    android:valueTo="100" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_glass"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/settings_glass_reset"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsSection"
            android:text="Behavior" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.mfp.filemanager.ui.views.LiquidSwitchView
                    android:id="@+id/switch_swipe_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Swipe Navigation"
                    app:onCard="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsSection"
            android:text="Privacy" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.mfp.filemanager.ui.views.LiquidSwitchView
                    android:id="@+id/switch_hidden_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Hidden Files"
                    app:onCard="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsSection"
            android:text="Data &amp; Storage" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_clear_cache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="Clear Cache" />

                    <TextView
                        android:id="@+id/text_cache_size"
                        style="@style/SettingsRowSubtitle"
                        android:layout_marginTop="2dp"
                        android:text="Calculating..." />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.6"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:id="@+id/layout_trash_retention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="Trash Retention" />

                    <TextView
                        android:id="@+id/text_trash_days"
                        style="@style/SettingsRowSubtitle"
                        android:layout_marginTop="2dp"
                        android:text="30 Days" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/SettingsSection"
            android:text="Updates" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.mfp.filemanager.ui.views.LiquidSwitchView
                    android:id="@+id/switch_auto_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatic Check"
                    app:onCard="true" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:alpha="0.6"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/layout_check_update"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="16dp">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="Check for Updates" />

                        <TextView
                            android:id="@+id/text_version"
                            style="@style/SettingsRowSubtitle"
                            android:layout_marginTop="2dp"
                            android:text="Version" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_changelog"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="Changelog"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/settings_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Settings"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>
</FrameLayout>
